# AI tool sensitive/runtime files — never commit these
stow/codex/.codex/auth.json
stow/codex/.codex/*.sqlite
stow/codex/.codex/*.sqlite-shm
stow/codex/.codex/*.sqlite-wal
stow/codex/.codex/*.jsonl
stow/claude/.claude/history.jsonl
stow/claude/.claude/.caveman-active
stow/ssh/.ssh/known_hosts
stow/ssh/.ssh/known_hosts.old
